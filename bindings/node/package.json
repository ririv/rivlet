{
  "name": "rivlet",
  "version": "0.6.0",
  "private": true,
  "description": "Composable task graphs with the Rivlet Rust core and JavaScript actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ririv/rivlet.git",
    "directory": "bindings/node"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "rivletNative": { "kind": "workspace" },
  "napi": {
    "binaryName": "rivlet",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --manifest-path ../../crates/node/Cargo.toml --output-dir native --no-js --dts binding.d.ts --release -- --locked",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build": "npm run build:native && tsc -p tsconfig.json",
    "stage:release": "node scripts/stage-release.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
